# ---------- Core ----------
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
TRUST_PROXY=true
RUN_JOBS=true

# ---------- Database: pick ONE ----------
# PostgreSQL
DB_CLIENT=pg
DATABASE_URL=postgres://user:pass@host:5432/waplatform
PG_SSL=false
# MSSQL / Azure SQL (set DB_CLIENT=mssql)
# MSSQL_SERVER=yourserver.database.windows.net
# MSSQL_PORT=1433
# MSSQL_DATABASE=waplatform
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=true

# ---------- Secrets (REQUIRED in production) ----------
# JWT_SECRET: 32+ random chars      -> openssl rand -hex 32
# ENCRYPTION_KEY: 32 bytes base64   -> openssl rand -base64 32   (do NOT lose it: WABA tokens are encrypted with it)
JWT_SECRET=
ENCRYPTION_KEY=

# ---------- CORS (separate frontends) ----------
CONSOLE_ORIGINS=https://console.example.com
PORTAL_ORIGINS=https://portal.example.com

# ---------- Meta (Tech Provider app) ----------
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=            # Embedded Signup configuration id
META_API_VERSION=v23.0
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=       # your own system-user token (used for attach/migrate flows)
META_WEBHOOK_VERIFY_TOKEN=    # any random string, same value in Meta dashboard

# ---------- First run seed ----------
SEED_STAFF_EMAIL=owner@example.com
SEED_STAFF_PASSWORD=ChangeMe-Strong-Pass-123
SEED_STAFF_NAME=Platform Owner
AUTO_APPROVE_TENANTS=false

# ---------- Misc ----------
DEFAULT_COUNTRY_CODE=91
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=WA Platform <no-reply@example.com>
RETENTION_DAYS_MESSAGES=180
RETENTION_DAYS_WEBHOOK=30
