# ================= REQUIRED (production) =================
NODE_ENV=production
PUBLIC_BASE_URL=https://api.example.com
TRUST_PROXY=true
CONSOLE_ORIGINS=https://console.example.com
PORTAL_ORIGINS=https://portal.example.com

# JWT_SECRET: 32+ random chars     -> openssl rand -hex 32
# ENCRYPTION_KEY: 32 bytes base64  -> openssl rand -base64 32  (do NOT lose/change it: WABA tokens are encrypted with it)
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Database: use ONE block only ----
# A) PostgreSQL
DB_CLIENT=pg
DATABASE_URL=postgres://user:pass@host:5432/waplatform
PG_SSL=true
# B) MSSQL / Azure SQL (set DB_CLIENT=mssql, remove DATABASE_URL and PG_SSL)
# DB_CLIENT=mssql
# MSSQL_SERVER=yourserver.database.windows.net
# MSSQL_PORT=1433
# MSSQL_DATABASE=waplatform
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=true

# ================= META (needed for WhatsApp features) =================
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v23.0

# ================= FIRST RUN SEED =================
SEED_STAFF_EMAIL=owner@example.com
SEED_STAFF_PASSWORD=ChangeMe-Strong-Pass-123
SEED_STAFF_NAME=Platform Owner

# ================= OPTIONAL (defaults work) =================
# PORT is set by Azure App Service automatically - do not set it there.
# RUN_JOBS=true
# AUTO_APPROVE_TENANTS=false
# DEFAULT_COUNTRY_CODE=91
# META_BUSINESS_ID=
# META_SYSTEM_USER_TOKEN=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=WA Platform <no-reply@example.com>
# RETENTION_DAYS_MESSAGES=180
# RETENTION_DAYS_WEBHOOK=30
 done bro 
